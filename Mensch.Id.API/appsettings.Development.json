{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://localhost:44321"
      }
    }
  },
  "MongoDB": {
    "User": "dev"
  },
  "FileStore": {
    "Directory": "~/data/dev/mensch-id/files"
  },
  "CORS": {
    "Origins": "https://localhost:3301"
  },
  "OpenIddict": {
    "SigningKeyPath": "../certs/oidc-signing-key.pem",
    "EncryptionKeyPath": "../certs/oidc-encryption-key.pem",
    "Clients": [
      {
        "ClientId": "mensch-id-app",
        "DisplayName": "mensch.ID App",
        "RedirectUris": [
          "menschid://auth/callback",
          "https://test.mensch.id/app/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "menschid://auth/logout",
          "https://test.mensch.id/app/auth/logout"
        ]
      }
    ]
  },
  "Email": {
    "UseDummySender": true
  }
}
