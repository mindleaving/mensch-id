{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information",
      "OpenIdDict": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5021"
      },
      "Https": {
        "Url": "https://localhost:44321"
      }
    }
  },
  "AllowedHosts": "*",
  "CORS": {
    "Origins": "https://localhost:3301"
  },
  "MongoDB": {
    "DatabaseName": "menschid",
    "User": "",
    "Server": "localhost:27017",
    "ReplicaSetName": "rs0"
  },
  "FileStore": {
    "Directory": "/data/dev/menschid/files"
  },
  "ExternalLogins": {
    "ObscureKey": ""
  },
  "Email": {
    "SmtpServerName": "localhost",
    "SmtpServerPort": 25,
    "UseAuthentication": false,
    "FromAddress": "noreply@mensch.id",
    "WebsiteBaseUrl": "https://mensch.id"
  },
  "Certificate": {
    "Algorithm": "RSA",
    "SigningPrivateKey": ""
  },
  "RateLimiter": {
    "PeriodInSeconds": 15,
    "TokensPerPeriod": 10,
    "TokenLimit": 100,
    "Credentials": {
      "WindowInSeconds": 60,
      "PermitLimit": 10
    }
  },
  "Authentication": {
    "OpenIdConnect": {
      "Providers": []
    },
    "ApiBaseUrl": "https://localhost:44321"
  },
  "OpenIddict": {
    "SigningKeyPath": "../certs/oidc-signing-key.pem",
    "EncryptionKeyPath": "../certs/oidc-encryption-key.pem",
    "Clients": [
      {
        "ClientId": "mensch-id-app",
        "DisplayName": "mensch.ID App",
        "RedirectUris": [
          "menschid://auth/callback",
          "https://localhost:44321/app/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "menschid://auth/logout",
          "https://localhost:44321/app/auth/logout"
        ]
      }
    ]
  }
}
