{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5021"
      }
    }
  },
  "AllowedHosts": "*",
  "CORS": {
    "Origins": "http://localhost:3000"
  },
  "MongoDB": {
    "DatabaseName": "MenschID",
    "Server": "localhost:27017",
    "ReplicaSetName": "<replica-set-name>"
  },
  "Authentication": {
    "OpenIdConnect": {
      "Providers": [
        {
          "Id": "google",
          "DisplayName": "Google",
          "Authority": "https://accounts.google.com"
        },
        {
          "Id": "microsoft",
          "DisplayName": "Microsoft",
          "Authority": "https://login.microsoftonline.com/consumers/v2.0"
        }
      ]
    },
    "ApiBaseUrl": "https://mensch.id"
  },
  "OpenIddict": {
    "SigningKeyPath": "/etc/mensch-id/oidc-signing-key.pem",
    "EncryptionKeyPath": "/etc/mensch-id/oidc-encryption-key.pem",
    "Clients": [
      {
        "ClientId": "mensch-id-app",
        "DisplayName": "mensch.ID App",
        "RedirectUris": [
          "https://mensch.id/app/auth/callback"
        ],
        "PostLogoutRedirectUris": [
          "https://mensch.id/app/auth/logout"
        ]
      }
    ]
  },
  "RateLimiter": {
    "Credentials": {
      "WindowInSeconds": 60,
      "PermitLimit": 10
    }
  }
}
